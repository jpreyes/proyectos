# Server-side base URL for PocketBase.
#   dev    -> http://127.0.0.1:8090
#   docker -> http://pocketbase:8090
PB_URL_INTERNAL=http://127.0.0.1:8090

# Browser-side base URL. Leave empty: the browser always talks to the same
# origin, and /api is routed to PocketBase by cloudflared (prod) or by the
# Next rewrite (dev).
NEXT_PUBLIC_PB_URL=
